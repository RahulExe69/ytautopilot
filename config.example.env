# Copy values into GitHub Actions secrets; never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# YouTube OAuth credentials (create these during setup)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Publishing safety: keep false until a test render is reviewed.
ENABLE_PUBLISH=false

# Only use a direct-download URL for gameplay footage you have permission to use.
GAMEPLAY_VIDEO_URL=
GAMEPLAY_VIDEO_LICENSE_NOTE=

# Voice and channel settings
TTS_VOICE=hi-IN-SwaraNeural
VIDEO_TITLE_PREFIX=
